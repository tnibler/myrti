  "components": {
    "schemas": {
      "AddAssetsToSeriesRequest": {
        "type": "object",
        "required": [
          "assetIds"
        ],
        "properties": {
          "assetIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetId"
            }
          }
        }
      },
      "Album": {
        "type": "object",
        "required": [
          "id",
          "numAssets",
          "createdAt",
          "changedAt"
        ],
        "properties": {
          "changedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "$ref": "#/components/schemas/AlbumId"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "numAssets": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AlbumDetailsResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "description": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlbumItem"
            }
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AlbumId": {
        "type": "string"
      },
      "AlbumItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AlbumItemType"
          },
          {
            "type": "object",
            "required": [
              "itemId"
            ],
            "properties": {
              "itemId": {
                "$ref": "#/components/schemas/AlbumItemId"
              }
            }
          }
        ]
      },
      "AlbumItemId": {
        "type": "string"
      },
      "AlbumItemType": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "asset",
              "itemType"
            ],
            "properties": {
              "asset": {
                "$ref": "#/components/schemas/AssetWithSpe"
              },
              "itemType": {
                "type": "string",
                "enum": [
                  "asset"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "text",
              "itemType"
            ],
            "properties": {
              "itemType": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "itemType"
        }
      },
      "AppendAssetsRequest": {
        "type": "object",
        "required": [
          "assetIds"
        ],
        "properties": {
          "assetIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetId"
            }
          }
        }
      },
      "AppendAssetsResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "assetId",
          "takenDate",
          "repFile"
        ],
        "properties": {
          "assetId": {
            "$ref": "#/components/schemas/AssetId"
          },
          "repFile": {
            "$ref": "#/components/schemas/AssetFile"
          },
          "takenDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssetDetailsResponse": {
        "type": "object",
        "required": [
          "exiftoolOutput"
        ],
        "properties": {
          "exiftoolOutput": {}
        }
      },
      "AssetFile": {
        "type": "object",
        "required": [
          "fileId",
          "assetRootId",
          "pathInRoot",
          "width",
          "height",
          "addedAt",
          "rotationCorrection",
          "mirrorCorrection",
          "mimeType"
        ],
        "properties": {
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "assetRootId": {
            "$ref": "#/components/schemas/AssetRootDirId"
          },
          "fileId": {
            "$ref": "#/components/schemas/FileId"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "mimeType": {
            "type": "string"
          },
          "mirrorCorrection": {
            "$ref": "#/components/schemas/MirrorCorrection"
          },
          "pathInRoot": {
            "type": "string"
          },
          "rotationCorrection": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AssetId": {
        "type": "string"
      },
      "AssetRootDirId": {
        "type": "string"
      },
      "AssetSeries": {
        "type": "object",
        "required": [
          "id",
          "assetIds",
          "selectionIndices"
        ],
        "properties": {
          "assetIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetId"
            }
          },
          "id": {
            "$ref": "#/components/schemas/AssetSeriesId"
          },
          "selectionIndices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "AssetSeriesId": {
        "type": "string"
      },
      "AssetSpe": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "object",
                "required": [
                  "assetType"
                ],
                "properties": {
                  "assetType": {
                    "type": "string",
                    "enum": [
                      "image"
                    ]
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Video"
              },
              {
                "type": "object",
                "required": [
                  "assetType"
                ],
                "properties": {
                  "assetType": {
                    "type": "string",
                    "enum": [
                      "video"
                    ]
                  }
                }
              }
            ]
          }
        ],
        "discriminator": {
          "propertyName": "assetType"
        }
