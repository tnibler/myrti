{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": ["vite.config.ts"]
}
